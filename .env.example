# Template for .env — copy to .env and fill in real values.
# .env itself is git-ignored; this file is the only one that should be committed.

# --- PostgreSQL / docker-compose ---
POSTGRES_DB=lifeguide_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# --- Spring datasource ---
DB_URL=jdbc:postgresql://localhost:5432/lifeguide_db
DB_USER=postgres
DB_PASSWORD=changeme

# --- App secrets ---
JWT_SECRET=changeme
